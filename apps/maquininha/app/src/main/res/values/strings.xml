<?xml version="1.0" encoding="utf-8"?>
<!--
  Todo texto de tela mora aqui, em português, porque é português que o operador
  atrás do balcão lê. Não há tradução e nem deve haver: o app roda em Smart POS
  de adquirente brasileira.

  Nenhuma string AQUI cita adquirente nenhuma. O que fala da adquirente (nome,
  o extrato onde procurar a venda, o app de pagamento) mora em
  src/<flavor>/res/values/adquirente.xml, porque cada APK é homologado por uma
  adquirente e a homologação reprova app que cita a concorrente.
-->
<resources>
