<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      NoActionBar porque a tela do terminal é pequena e cada faixa que não mostra
      o valor da compra é espaço desperdiçado.

      O tema herda de AppCompat (e não de Material3) para manter a lista de
      dependências curta: quanto menos biblioteca entra no APK, menos coisa a
      análise de homologação tem para perguntar.
    -->
    <style name="TemaDaMaquininha" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:colorAccent">@color/destaque</item>
        <item name="colorAccent">@color/destaque</item>
    </style>
</resources>
