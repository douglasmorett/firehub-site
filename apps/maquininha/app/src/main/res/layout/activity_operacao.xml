<?xml version="1.0" encoding="utf-8"?>
<!--
  A tela que fica no ar o dia inteiro.

  O valor é o elemento maior da tela por um motivo prático: é a única informação
  que o cliente precisa conferir antes de encostar o cartão, e ele está de pé, a
  meio metro do aparelho, quase sempre com pressa.

  Os botões têm 76dp de altura mínima porque quem toca é o dedo de quem está com
  a outra mão segurando a carteira, e um toque errado aqui cobra na forma de
  pagamento errada.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTerminal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/texto_fraco"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRede"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_fraco"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtValor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/destaque"
                android:textSize="52sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/texto_fraco"
                android:textSize="19sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtAndamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/texto"
                android:textSize="21sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/painelEscolha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/botaoCredito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/botao_principal"
                android:minHeight="76dp"
                android:text="@string/operacao_credito"
                android:textColor="@color/texto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/botaoDebito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/botao_principal"
                android:minHeight="76dp"
                android:text="@string/operacao_debito"
                android:textColor="@color/texto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/botaoVoucher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/botao_secundario"
                android:minHeight="68dp"
                android:text="@string/operacao_voucher"
                android:textColor="@color/texto"
                android:textSize="19sp" />
        </LinearLayout>

        <Button
            android:id="@+id/botaoCancelar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/botao_secundario"
            android:minHeight="64dp"
            android:text="@string/operacao_cancelar"
            android:textColor="@color/texto_fraco"
            android:textSize="17sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/botaoAcao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/botao_principal"
            android:minHeight="72dp"
            android:textColor="@color/texto"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtAvisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/atencao"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
