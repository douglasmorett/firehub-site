// === MÓDULO DE EMBAIXADORES / AFILIADOS ===
model Ambassador {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  phone             String?
  code              String     @unique // ex: "marcos" -> ?ref=marcos
  commissionPercent Float      @default(20) // % de comissão recorrente (ex: 20%)
  asaasWalletId     String?    // ID da conta/carteira no Asaas para Split
  pixKey            String?    // Referência opcional
  active            Boolean    @default(true)
  password          String?    // Hash da senha (opcional para quem logar no portal)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  referredStores    User[]     @relation("AmbassadorStores")

  /// Rede de 2 níveis. Quem trouxe ESTE embaixador para o programa: ele leva
  /// `level2Percent` das lojas que este aqui indicar. Para no segundo nível —
  /// o billing não sobe para o avô de propósito.
  parentAmbassadorId String?
  parentAmbassador   Ambassador?  @relation("AmbassadorTree", fields: [parentAmbassadorId], references: [id], onDelete: SetNull)
  subAmbassadors     Ambassador[] @relation("AmbassadorTree")
  level2Percent      Float        @default(3) // % que ele recebe dos indicados dos seus indicados

  /// A loja do próprio embaixador, quando ele também é lojista (promovido pelo
  /// admin). O vínculo é só leitura para o painel: `User.ambassadorId` continua
  /// apontando para quem indicou a loja dele, que é o que preserva a comissão
  /// de nível 1 já contratada.
  linkedUserId      String?    @unique
  linkedUser        User?      @relation("AmbassadorAccount", fields: [linkedUserId], references: [id], onDelete: SetNull)

  @@index([parentAmbassadorId])
}

// === API ABERTA & WEBHOOKS DE SAÍDA (OPEN API V1) ===
model ApiKey {
  id           String    @id @default(cuid())
  franchiseeId String
  franchisee   User      @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
