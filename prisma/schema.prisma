generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  password        String
  role            String          @default("FRANCHISEE")
  city            String?
  cpfCnpj         String?
  slug            String?         @unique
  storeName       String?
  storePhone      String?
  storeAddress    String?
  storeBanner     String?
  storeLogo       String?
  storeHours      Json?
  storeDeliveryOnly Boolean   @default(true)
  paymentFees     Json?
  deliveryZoneType String?
  deliveryZones   Json?
  storeLatLng     Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  permissions     String          @default("")
  ownerId         String?
  owner           User?           @relation("StoreStaff", fields: [ownerId], references: [id], onDelete: Cascade)
  staff           User[]          @relation("StoreStaff")
  isFranqueadoHakim Boolean      @default(false)
  deliveryConfig  Json?           // Config: freeShipping, freeShippingMinValue
  fiscalConfig    Json?           // Config Fiscal: { enabled, autoEmitPaymentMethods, ambiente, cnpj, ie }
  storeOpen       Boolean         @default(true)
  cashOpen        Boolean         @default(false)
  storePause      Json?           // { active, from, to, reason }
  storeCoupons    Json?           // Array de cupons de desconto
  pagarmeRecipientId String?      // ID do destinatário no Pagar.me (split por restaurante)
  facebookPixelId String?         // ID do Pixel do Facebook/Meta Ads
  autoAcceptOrders Boolean        @default(false) // Auto-aceitar pedidos online
  allowScheduledOrders Boolean     @default(true)  // Permitir agendamento de pedidos no site próprio
  storeAlertSound  String?        @default("bell") // Som de alerta: bell | chime | beep | none
  storeTimezone    String?        @default("America/Sao_Paulo") // Fuso horário regional do restaurante
  storeLoyalty    Json?           // { type: cashback|points, rate: 2, active: true }
  storeOrderCount Int             @default(0) // Contador de pedidos (Pay as You Grow)
  printerConfig   Json?           // Config de impressoras: { autoprint, autoBeverageTag, customBeverageKeywords, defaultPaperWidth, printers: [{ id, name, label, categories, copies, paperWidth: "58mm"|"80mm", columns?: number, escposProfile?: "full"|"safe"|"legacy" }] }
  timeAlertConfig Json?           // Config de alertas visuais de tempo: { yellowEnabled, yellowMinutes, redEnabled, redMinutes }
  etaConfig       Json?           // Config do ETA dinamico por loja: { motoboysCount, updatedAt, updatedBy }. Persiste ate alguem mudar (nao reseta diariamente).
  kdsScreens      Json?           // Telas KDS configuradas da loja: [{id, name, stage, filter, categoryFilter}]
  chatbotConfig   Json?           // Config do Chatbot IA WhatsApp: { active, connected, phone, pairingCode, qrCode, personality, customPrompt, autoOrderLink }
  fixedCosts      Json?           // Custos fixos mensais: [{id, label, value}] ex: aluguel, funcionários
  financialGoals  Json?           // Metas financeiras mensais: { faturamento, margemLiquida, cmvPct, pedidos, ticketMedio }
  repasseConfig   Json?           // Configurações de Repasse Automático: { chavePix, tipoChave, titular, cpfCnpj, frequencia, horario, status }
  resetToken      String?         // Token de recuperação de senha
  resetTokenExp   DateTime?       // Expiração do token de recuperação
  trialEndsAt     DateTime?       // Data limite de teste/benefício concedido
  notificationPhone String?       // Telefone VIP para receber alertas e acessar relatórios pelo bot oficial
  isFireHubSystem   Boolean       @default(false) // Define se esta conta é a matriz oficial do sistema FireHub
  // === FATURAMENTO: USE FIRST, PAY LATER ===
  planPercent     Float           @default(1)  // % cobrado sobre vendas (ex: 1.0 = 1%)
  billingCycles   FranchiseeBillingCycle[]
  // === META ADS ===
  metaFbPageId      String?        // ID da Página do Facebook conectada
  metaFbAccessToken String?        @db.Text  // Token OAuth do Facebook (longa duração)
  metaAdAccountId   String?        // act_XXXXXXX — conta de anúncios
  metaPixelId       String?        // Pixel Meta instalado no cardápio
  // Cota de imagens geradas por IA para anúncio. O pacote de R$50/semana
  // inclui 10 gerações; sem teto, um lojista indeciso clicando "gerar outra"
  // consumiria boa parte da margem sozinho (cada imagem custa ~R$0,21).
  metaIaGeracoesUsadas   Int       @default(0)
  metaIaSemanaReferencia String?   // "2026-W34" — vira a cota quando muda
  metaAdsEnabled    Boolean        @default(false) // Módulo ativo
  metaAdsWeeklyFee  Float           @default(50) // Taxa semanal FireHub pela gestão de Meta Ads (R$)
  metaAdsCampaigns  MetaAdsCampaign[]
  // === GATEWAYS DE PAGAMENTO ===
  mpSellerId        String?        // ID do vendedor no Mercado Pago Marketplace
  mpAccessToken     String?  @db.Text // OAuth token do restaurante no MP
  mpRefreshToken    String?  @db.Text // Refresh token MP
  celcoinAccountId  String?        // Subconta Celcoin do restaurante (quando disponível)
  // === IFOOD INTEGRATION ===
  ifoodMerchantId       String?        // UUID da loja no iFood
  ifoodAccessToken      String?        @db.Text  // Bearer token (OAuth iFood Merchant API)
  ifoodRefreshToken     String?        @db.Text
  ifoodTokenExpiresAt   DateTime?
  ifoodAuthVerifier     String?
  ifoodClientId         String?        // Client ID do app cadastrado no iFood Developer
  ifoodConnected        Boolean        @default(false) // Módulo iFood ativo
  ifoodWidgetId         String?        // ID do widget iFood (chat integrado — do Portal do Parceiro)
  ifoodSyncDeliveryTime Boolean        @default(false) // Sincronizar tempo de entrega/preparo com iFood
  // === JOTAJA / OPEN DELIVERY ===
  jotajaClientId    String?        // Client ID no Jotajá
  jotajaClientSecret String?       // Client Secret no Jotajá
  jotajaMerchantId  String?        // UUID da loja no Jotajá
  jotajaConnected   Boolean        @default(false) // Módulo Jotajá ativo
  // === 99FOOD INTEGRATION ===
  food99MerchantId  String?        // ID da loja no 99Food
  food99AppId       String?        // App ID no 99Food / OpenDelivery
  food99SecretKey   String?        // Secret Key no 99Food
  food99Connected   Boolean        @default(false) // Módulo 99Food ativo
  showReviewsOnMenu Boolean        @default(true)  // Exibir avaliações no cardápio digital
  showAddressOnMenu Boolean        @default(true)  // Exibir endereço da loja no cardápio digital
  ambassadorId    String?        // ID do embaixador que indicou esta loja
  ambassador      Ambassador?    @relation("AmbassadorStores", fields: [ambassadorId], references: [id], onDelete: SetNull)
  onboardingData  Json?          // { comoConheceu, faturamento, etc }
  // === INDIQUE E GANHE (Parceiros/Revendedores) ===
  referredById    String?
  referredBy      User?          @relation("UserReferrals", fields: [referredById], references: [id])
  referrals       User[]         @relation("UserReferrals")
  asaasWalletId   String?        // Carteira Asaas para o split de pagamentos

  apiKeys         ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  orders          Order[]
  customerOrders  CustomerOrder[]
  storeReviews    StoreReview[]
  motoboys        Motoboy[]
  waiters         Waiter[]
  menuProducts    MenuProduct[]
  stockItems      StockItem[]
  stockInvoices   StockInvoice[]
  menuCategories  MenuCategory[]
  routeSchedules  RouteSchedule[]
  tables          Table[]

  // === MULTI-LOJAS ===
  accountGroupId    String?          // ID do grupo (= ID do User master/primeira loja)
  accountGroup      User?            @relation("AccountGroup", fields: [accountGroupId], references: [id])
  linkedStores      User[]           @relation("AccountGroup")
  isPrimaryStore    Boolean          @default(true)  // true = loja principal da conta

  // === MULTI IFOOD ===
  ifoodIntegrations IfoodIntegration[]

  // === CONTA FUNCIONÁRIO (FIADO) ===
  employeeAccountEnabled Boolean @default(false)
  storeEmployees        StoreEmployee[]
  employeePayments       EmployeePayment[]

  // === TOTEM DE AUTOATENDIMENTO ===
  totemEnabled        Boolean   @default(false) // Módulo Totem ativo
  totemConfig         Json?     // { theme, welcomeMessage, inactivityTimeout, requireCustomerName }
  totemLicenses       TotemLicense[]

  // === MAQUININHA (PDV FÍSICO) ===
  posTerminals        PosTerminal[]

  // === TRACKING DE CUSTOS ===
  usageLogs           UsageLog[]

  @@index([ifoodMerchantId])
  @@index([jotajaMerchantId])
  @@index([accountGroupId])
}

model IfoodIntegration {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label           String    // Nome amigável: "Hakim Centro iFood"
  merchantId      String    // UUID do merchant no iFood
  accessToken     String?   @db.Text
  refreshToken    String?   @db.Text
  tokenExpiresAt  DateTime?
  clientId        String?   // Client ID (app distribuído)
  clientSecret    String?   // Client Secret (app distribuído)
  authVerifier    String?
  widgetId        String?
  connected       Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, merchantId])
  @@index([merchantId])
}


model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Float
  imageUrl    String?
  category    String?
  labelData   Json?
  active      Boolean     @default(true)
  franchiseOnly Boolean   @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id             String         @id @default(cuid())
  userId         String
  totalAmount    Float
  status         String         @default("PENDING_PAYMENT")
  boletoUrl      String?
  asaasPaymentId String?
  deliveryDate   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cancelReason   String?
  isEmergency    Boolean        @default(false)
  emergencyStatus String?
  rejectionReason String?
  user           User           @relation(fields: [userId], references: [id])
  history        OrderHistory[]
  items          OrderItem[]
}

model OrderHistory {
  id          String   @id @default(cuid())
  orderId     String
  statusFrom  String
  statusTo    String
  actionBy    String
  actionEmail String
  notes       String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model RouteSchedule {
  id           String          @id @default(cuid())
  cityName     String?
  deliveryDay  Int?
  franchiseeId String?
  routeNumber  String          @default("1")
  motoboyId    String?
  status       String          @default("PENDING") // PENDING | DISPATCHED | CANCELLED
  color        String?         @default("#3B82F6")
  dispatchedAt DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  franchisee   User?           @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  motoboy      Motoboy?        @relation(fields: [motoboyId], references: [id], onDelete: SetNull)
  orders       CustomerOrder[]

  @@index([franchiseeId])
  @@index([franchiseeId, status])
}

model Payable {
  id                 String            @id @default(cuid())
  franchiseeId       String?
  supplierName       String
  barcode            String?
  receivedDate       DateTime
  dueDate            DateTime
  value              Float
  status             String            @default("PENDING")
  category           String            @default("BUSINESS")
  paidDate           DateTime?
  paymentType        String?           @default("BOLETO")
  pixKey             String?
  pixKeyName         String?
  pixKeyType         String?
  creditCardId       String?
  recurringPayableId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  creditCard         CreditCard?       @relation(fields: [creditCardId], references: [id])
  recurringPayable   RecurringPayable? @relation(fields: [recurringPayableId], references: [id], onDelete: SetNull)

  @@index([franchiseeId])
  @@index([franchiseeId, status])
}

model RecurringPayable {
  id           String      @id @default(cuid())
  franchiseeId String?
  supplierName String
  value        Float
  category     String      @default("BUSINESS")
  paymentType  String      @default("BOLETO")
  dueDateDay   Int
  barcode      String?
  pixKey       String?
  pixKeyName   String?
  pixKeyType   String?
  creditCardId String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id])
  payables     Payable[]

  @@index([franchiseeId])
}

model CreditCard {
  id                String             @id @default(cuid())
  franchiseeId      String?
  name              String
  lastDigits        String?
  bankName          String?
  limit             Float?
  closingDay        Int?
  dueDay            Int?
  bestPurchaseDay   Int?
  pixKey            String?
  pixKeyType        String?            @default("CPF")
  active            Boolean            @default(true)
  color             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payables          Payable[]
  recurringPayables RecurringPayable[]

  @@index([franchiseeId])
}

model PurchaseInvoice {
  id              String    @id @default(cuid())
  franchiseeId    String?
  description     String
  imageUrl        String
  aiValue         Float?
  aiCategory      String?
  aiRawText       String?   @db.Text
  invoiceDate     DateTime?
  status          String    @default("PENDING")
  category        String    @default("BUSINESS")
  rejectionReason String?
  source          String    @default("ai")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  uploadedBy      String

  @@index([franchiseeId])
}

model KitchenItem {
  id            String   @id @default(cuid())
  franchiseeId  String?
  name          String
  shelfLifeDays Int      @default(1)
  ingredients   String?
  allergens     String?
  preparation   String?
  weightStr     String?  @default("N/A")
  energy        String?  @default("0")
  carbs         String?  @default("0")
  sugars        String?  @default("0")
  addedSugars   String?  @default("0")
  proteins      String?  @default("0")
  fatTotal      String?  @default("0")
  fatSat        String?  @default("0")
  sodium        String?  @default("0")
  highSugar     Boolean  @default(false)
  highSodium    Boolean  @default(false)
  highFat       Boolean  @default(false)
  transgenic    Boolean  @default(false)
  customCnpj    String?
  customAddress String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([franchiseeId])
}

// ========== SISTEMA DE PEDIDOS DO CLIENTE FINAL ==========

model MenuProduct {
  id              String              @id @default(cuid())
  franchiseeId    String?
  name            String
  description     String
  price           Float
  cost            Float?
  tags            String?             // JSON array: ["Novo","Mais Vendido","Promoção","Esgotado","Vegano","Picante"]
  availableDays   String?             // JSON array: ["SEG","TER","QUA","QUI","SEX","SAB","DOM"] (null/empty = todos os dias)
  imageUrl        String?
  category        String              @default("Lanches")
  active          Boolean             @default(true)
  isCombo         Boolean             @default(false)
  isBeverage      Boolean             @default(false)
  comboConfig     Json?
  fiscalBreakdown Json?               // Engenharia de Cardápio Fiscal: [{ name, price, category, ncm }]
  // === DADOS TRIBUTÁRIOS FISCAIS DO PRODUTO ===
  ncm             String?             // ex: 1604.20.90
  cest            String?             // ex: 28.062.00
  cfop            String?             @default("5102") // ex: 5102
  origem          String?             @default("0")    // 0 = Nacional
  csosn           String?             @default("102")  // ex: 102 (Simples Nacional)
  pis             String?             @default("49")   // ex: 49
  cofins          String?             @default("49")   // ex: 49
  // Canais de venda
  activePDV       Boolean             @default(true)   // Disponível no PDV (atendente)
  activeDelivery  Boolean             @default(true)   // Disponível no Delivery online
  /// Os quatro canais nascem LIGADOS. Antes, PDV e Delivery vinham `true` e
  /// Totem e Garçom vinham `false`: produto criado por qualquer caminho que não
  /// preenchesse os campos — import de CSV, sincronização do iFood, JotaJá —
  /// aparecia no balcão e sumia do totem, sem nada avisar. Eram 194 de 331
  /// produtos invisíveis no totem por causa disso. Quem não quer o item num
  /// canal desliga na tela; o padrão é o cardápio inteiro em todo lugar.
  activeTotem     Boolean             @default(true)   // Disponível no Totem de autoatendimento
  activeGarcom    Boolean             @default(true)   // Disponível para o garçom (mesa)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  franchisee      User?               @relation(fields: [franchiseeId], references: [id])
  orderItems      CustomerOrderItem[]
  comboGroups     ComboGroup[]
  comboGroupItems ComboGroupItem[]
  recipeItems     ProductRecipe[]

  @@index([franchiseeId])
  @@index([franchiseeId, active])
}


model MenuCategory {
  id           String   @id @default(cuid())
  franchiseeId String?
  name         String
  emoji        String   @default("🍽️")
  imageUrl     String?
  color        String   @default("#64748B")
  sortOrder    Int      @default(0)
  franchisee   User?    @relation(fields: [franchiseeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Contador atômico do número diário de pedido, por loja e por dia.
///
/// Existe porque a versão anterior gerava o número dentro de uma transação
/// Serializable que só FAZIA LEITURA (count + findFirst). O SSI do PostgreSQL
/// não detecta conflito entre transações somente-leitura, e o INSERT acontecia
/// depois, fora dela — então dois pedidos simultâneos recebiam o MESMO número.
/// Aconteceu em produção em 22/08/2026: dois pedidos do iFood às 17:39 saíram
/// como #16, e o seguinte pulou para #18.
///
/// Aqui o número vem de `UPDATE ... SET lastNumber = lastNumber + 1 RETURNING`,
/// que o Postgres serializa no lock da linha. Não há janela de corrida.
model DailyOrderCounter {
  franchiseeId String
  dateKey      String   // "YYYY-MM-DD" no fuso America/Sao_Paulo
  lastNumber   Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([franchiseeId, dateKey])
}

model ComboGroup {
  id            String           @id @default(cuid())
  menuProductId String
  title         String
  maxQty        Int
  /// Quantas escolhas o grupo exige no mínimo.
  ///
  /// NULO mantém a regra antiga — exigir exatamente `maxQty` —, que é a única
  /// que existiu até aqui e que todos os combos já gravados esperam.
  ///
  /// Sem esta coluna não havia grupo opcional: o cardápio só sabia dizer
  /// "escolha exatamente N", então um grupo de adicionais que deveria ser
  /// livre (0 a 4) obrigava o cliente a levar 4 adicionais pagos. Foi o que
  /// travou a cópia do cardápio do Anota AI para a Pastel da Paulista, onde
  /// 55 dos 123 grupos são opcionais.
  ///
  /// 0 = opcional (o cliente pode não escolher nada).
  minQty        Int?
  sortOrder     Int              @default(0)
  menuProduct   MenuProduct      @relation(fields: [menuProductId], references: [id], onDelete: Cascade)
  items         ComboGroupItem[]

  @@index([menuProductId])
}

model ComboGroupItem {
  id              String      @id @default(cuid())
  comboGroupId    String
  menuProductId   String
  additionalPrice Float       @default(0) // Valor adicional cobrado se este item for escolhido no combo
  /// Teto de repetição DESTA opção dentro do grupo. Nulo = só o teto do grupo.
  ///
  /// É o "Máx 2" que aparece embaixo de cada adicional: o grupo aceita 4 itens
  /// no total, mas ninguém leva 4 bacons. Sem isto, o único limite era o do
  /// grupo, e a mesma opção podia ser repetida até enchê-lo.
  maxPerItem      Int?
  /// Texto curto sob o nome da opção ("13cm", "22cm"). Existe porque a opção
  /// pode ser um produto genérico ("Baby") reaproveitado em dezenas de grupos,
  /// e o que muda de um para outro é justamente essa linha.
  optionNote      String?
  comboGroup      ComboGroup  @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)
  menuProduct     MenuProduct @relation(fields: [menuProductId], references: [id])

  @@index([comboGroupId])
  @@index([menuProductId])
}

model CustomerOrder {
  id               String              @id @default(cuid())
  franchiseeId     String
  customerId       String?
  customerName     String
  customerPhone    String
  customerAddress  String?
  deliveryType     String              @default("DELIVERY")
  paymentMethod    String?
  totalAmount      Float
  deliveryFee      Float               @default(0)
  motoboyFee       Float?
  deliveryDistance Float?
  motoboyId        String?
  status           String              @default("NOVO")
  source           String              @default("ONLINE")
  notes            String?
  rating           Int?
  ratingComment    String?
  // Pagar.me — campos legados (mantidos para compatibilidade com pedidos antigos)
  pagarmeOrderId   String?             // ID do pedido no Pagar.me
  pagarmeChargeId  String?             // ID da cobrança
  pagarmeStatus    String?             // pending | paid | failed | canceled
  pagarmePixQrCode String?  @db.Text  // QR code PIX (base64)
  pagarmePixExpiry DateTime?           // Expiração do PIX
  pagarmeMethod    String?             // pix | credit_card | debit_card | voucher
  paymentPaidAt    DateTime?           // Confirmação de pagamento
  cashbackEarned   Float?              // Cashback gerado neste pedido (R$)
  cashbackUsed     Float?              // Cashback resgatado neste pedido (R$)
  // === GATEWAY UNIFICADO (Mercado Pago / Celcoin) ===
  gatewayProvider  String?             // mercadopago | celcoin | manual
  gatewayPaymentId String?             // ID do pagamento no gateway ativo
  // === IFOOD ===
  ifoodOrderId        String?  @unique   // ID do pedido no iFood (idempotência)
  ifoodReference      String?            // Número de exibição do pedido no iFood (#ABC123)
  scheduledDatetime   DateTime?          // Cen1: Data/hora agendada (SCHEDULED orders)
  changeAmount        Float?             // Cen5: Valor do troco (pagamento em dinheiro)
  customerCpfCnpj     String?            // Cen5: CPF/CNPJ do cliente para NF
  cancelledBy         String?            // Cen4: quem cancelou: RESTAURANT | IFOOD | CUSTOMER
  cancelReason        String?            // Motivo do cancelamento
  cancelDispute       Json?              // Negociação: { pending, reason, code, requestedAt }
  // === EMISSÃO FISCAL (NFC-e / NF-e) ===
  fiscalStatus        String?   @default("PENDING") // PENDING | EMITTED | FAILED | CANCELED
  fiscalInfo          Json?              // { nfceKey, nfceNumber, emittedAt, xmlUrl, pdfUrl, fiscalItems: [...] }
  // === DISCRIMINAÇÃO DE DESCONTOS ===
  discountTotal       Float?             // Desconto total aplicado no pedido
  discountIfood       Float?             // Quanto o iFood subsidia (sponsorship: IFOOD)
  discountMerchant    Float?             // Quanto a loja subsidia (sponsorship: MERCHANT)
  discountDetails     Json?              // JSON com detalhes: [{target, value, sponsor, description}]
  // === NUMERAÇÃO ESTÁTICA ===
  dailyOrderNumber    Int?               // Sequência diária fixa do pedido (#1, #2, #3...)
  // === LOGÍSTICA IFOOD (Motoboy iFood) ===
  deliveryBy             String?            // "IFOOD" (Entrega Parceira) ou "MERCHANT" (Entrega Própria)
  ifoodPickupCode        String?            // Código de Coleta Parceira do iFood (ex: 1595)
  ifoodDriverName        String?            // Nome do entregador iFood
  ifoodDriverPhone       String?            // Telefone do entregador
  ifoodDriverVehicle     String?            // Veículo (MOTORCYCLE, BICYCLE, CAR)
  ifoodDriverPhotoUrl    String?            // Foto do entregador
  ifoodDriverStatus      String?            // REQUESTED, ASSIGNED, GOING_TO_ORIGIN, ARRIVED_AT_ORIGIN, COLLECTED, DISPATCHED, ARRIVED_AT_DESTINATION, DELIVERED, FAILED
  ifoodDriverRequestedAt DateTime?          // Quando o motoboy foi solicitado
  ifoodDeliveryEta       DateTime?          // Previsão de entrega
  // === OPEN DELIVERY / JOTAJA ===
  openDeliveryOrderId     String?   @unique   // ID do pedido no Open Delivery (idempotência)
  openDeliveryReference   String?             // Número de exibição do pedido (#1234)
  openDeliveryChannel     String?             // Canal de origem: "JOTAJA"
  // === ROTEIRIZAÇÃO ===
  routeId          String?
  isRoutePriority  Boolean             @default(false) // Destaque PRIORIDADE PARA ROTA no KDS
  routeSchedule    RouteSchedule?      @relation(fields: [routeId], references: [id], onDelete: SetNull)
  // === KDS (Kitchen Display System) ===
  kdsStage          String?             // "PRODUCTION" | "FINISHING" | null
  kdsStationId      Int?                // Estação que pegou o pedido (1, 2, etc.)
  kdsProductionAt   DateTime?           // Quando entrou em produção
  kdsFinishingAt    DateTime?           // Quando entrou em finalização
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  // === CONTA FUNCIONÁRIO (FIADO) ===
  employeeId        String?
  employeeName      String?
  employee          StoreEmployee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  // === TOTEM ===
  totemLicenseId    String?   // ID do totem que gerou o pedido
  // === MAQUININHA (MERCADO PAGO POINT) ===
  // ID da Order no MP ("ORD01J..."). O webhook do Point não carrega nada nosso
  // além disto, então é por este campo que o pedido é encontrado — daí o índice.
  posOrderId        String?
  posTerminalId     String?             // Em qual Point a cobrança subiu, para o operador saber em qual visor olhar
  posStatus         String?             // Último status vindo do MP: created | processed | canceled | refunded | failed | expired | action_required
  // Quantas vezes esta comanda já foi mandada para a maquininha. Entra na
  // X-Idempotency-Key: a chave vale 24h no MP, então sem contador a segunda
  // tentativa (depois de um cancelamento ou de uma recusa) devolveria a ordem
  // antiga em vez de acender uma cobrança nova no visor.
  posTentativas     Int                 @default(0)
  // === MESA ===
  tableSessionId    String?             // Sessão de mesa vinculada
  tableSession      TableSession?       @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)

  franchisee       User                @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  customer         StoreCustomer?      @relation(fields: [customerId], references: [id])
  motoboy          Motoboy?            @relation(fields: [motoboyId], references: [id])
  items            CustomerOrderItem[]
  review           StoreReview?

  @@index([franchiseeId])
  @@index([franchiseeId, status])
  @@index([franchiseeId, createdAt])
  @@index([motoboyId])
  @@index([routeId])
  @@index([employeeId])
  @@index([openDeliveryReference])
  @@index([tableSessionId])
  @@index([posOrderId])
}

// ─── MÓDULO DE MESAS ──────────────────────────────────────────────────────────

model Table {
  id              String         @id @default(cuid())
  franchiseeId    String
  franchisee      User           @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  number          Int            // Número exibido (editável)
  label           String?        // Nome customizado (ex: "Varanda 1", "VIP")
  capacity        Int            @default(4)
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  sessions        TableSession[]
  createdAt       DateTime       @default(now())

  @@unique([franchiseeId, number])
  @@index([franchiseeId])
}

model TableSession {
  id              String          @id @default(cuid())
  tableId         String
  table           Table           @relation(fields: [tableId], references: [id], onDelete: Cascade)
  franchiseeId    String
  status          String          @default("OPEN") // OPEN | CLOSING | CLOSED
  customerName    String?         // Nome opcional do cliente/grupo
  waiterName      String?         // Nome do garçom
  waiterId        String?         // ID do garçom vinculado
  waiter          Waiter?         @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  notes           String?
  serviceFee      Float?          // Taxa de serviço cobrada (ex: 10%)
  waiterTip       Float?          // Gorjeta adicional
  waiterCommission Float?         // Valor total da comissão (serviço + gorjeta)
  totalPaid       Float?          // Total pago no fechamento
  paymentMethods  Json?           // [{method: "Pix", amount: 100}, ...]
  orders          CustomerOrder[]
  guests          TableGuest[]
  createdAt       DateTime        @default(now())

  @@index([tableId])
  @@index([franchiseeId, status])
  @@index([waiterId])
}

/// Pessoa sentada na mesa.
///
/// Existe para responder "quem pediu o quê" ANTES da hora de pagar. Sem isso, na
/// hora de rachar a conta o garçom precisa lembrar de cabeça quem comeu o quê —
/// e é aí que a mesa demora, o cliente reclama e alguém paga a mais.
model TableGuest {
  id              String          @id @default(cuid())
  tableSessionId  String
  session         TableSession    @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  name            String          // "Cliente 1", "João", "Camisa azul"
  sortOrder       Int             @default(0)
  items           CustomerOrderItem[]
  createdAt       DateTime        @default(now())

  @@index([tableSessionId])
}

model StoreEmployee {
  id            String            @id @default(cuid())
  franchiseeId  String
  franchisee    User              @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  name          String
  role          String?           // Cargo / Função (ex: Atendente, Cozinheiro)
  phone         String?
  cpf           String?
  creditLimit   Float?            // Limite de crédito opcional
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  orders        CustomerOrder[]
  payments      EmployeePayment[]

  @@index([franchiseeId])
}

model EmployeePayment {
  id            String        @id @default(cuid())
  franchiseeId  String
  franchisee    User          @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      StoreEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount        Float         // Valor do abatimento (ex: R$ 300,00)
  notes         String?       // Observação opcional
  createdAt     DateTime      @default(now())

  @@index([employeeId])
  @@index([franchiseeId])
}

// ========== TOTEM DE AUTOATENDIMENTO ==========
model TotemLicense {
  id                String    @id @default(cuid())
  franchiseeId      String
  franchisee        User      @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  label             String    // Nome amigável: "Totem 1 - Entrada"
  token             String    @unique  // JWT token único da licença
  deviceFingerprint String?   @unique  // Hash do fingerprint do navegador
  active            Boolean   @default(true)
  lastHeartbeat     DateTime? // Último ping do totem
  lastIp            String?   // IP do último heartbeat
  userAgent         String?   // User agent do dispositivo
  monthlyPrice      Float     @default(100) // R$ 100/mês
  // Maquininha que fica fisicamente ao lado deste totem. Sem isso o cliente
  // escolhe "cartão" na tela e ninguém sabe em qual das Points da loja jogar a
  // cobrança — com dois totens no salão, o pedido de um sobe no visor do outro.
  posTerminalId     String?
  posTerminal       PosTerminal? @relation(fields: [posTerminalId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([franchiseeId])
  @@index([token])
  @@index([posTerminalId])
}

// Maquininha física cadastrada pela loja. Guardamos o terminal no banco em vez
// de consultar a lista do Mercado Pago a cada venda porque o caixa não pode
// esperar uma chamada externa (nem quebrar quando ela cai) só para descobrir
// para onde mandar a cobrança.
model PosTerminal {
  id            String    @id @default(cuid())
  franchiseeId  String
  franchisee    User      @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  // Qual adquirente. Hoje só existe o Point, mas o campo evita migrar a tabela
  // inteira quando entrar Stone/Cielo — o formato do externalId muda com cada uma.
  provider      String    @default("MERCADOPAGO_POINT")
  // terminal_id do MP, no formato "NEWLAND_N950__N950NCB801293324". É o que vai
  // em config.point.terminal_id na criação da ordem.
  externalId    String
  label         String    // Nome que o operador reconhece: "Point do balcão"
  storeId       String?   // store_id do MP — loja física à qual a maquininha está vinculada lá
  posId         String?   // pos_id do MP — caixa/PDV ao qual ela está vinculada lá
  // PDV | STANDALONE | UNDEFINED. Fora de PDV a maquininha ignora a cobrança
  // enviada por API e só aceita valor digitado à mão; guardar o modo deixa a
  // tela avisar isso antes da venda, em vez de o pedido sumir no silêncio.
  operatingMode String?
  // Maquininha devolvida ou trocada não some do histórico: pedidos antigos
  // apontam para ela. Desliga aqui e ela deixa de aparecer na hora de cobrar.
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  totemLicenses TotemLicense[]

  // A mesma maquininha não pode ser cadastrada duas vezes na mesma loja: dois
  // registros para o mesmo terminal_id fariam o webhook casar com o cadastro errado.
  @@unique([franchiseeId, externalId])
  @@index([franchiseeId])
}


model CustomerOrderItem {
  id              String        @id @default(cuid())
  orderId         String
  menuProductId   String?
  productName     String?       // Nome do produto na hora do pedido (preserva histórico se menu product for deletado)
  quantity        Int
  price           Float
  notes           String?       // Observacao do cliente POR ITEM ("sem cebola"). O front ja enviava e a impressao/KDS ja liam, mas nao havia coluna: a observacao era descartada em silencio.
  comboSelections Json?
  // Quem, na mesa, pediu este item. Nulo quando o pedido é da mesa inteira
  // (couvert, entrada para dividir) ou quando não é pedido de mesa.
  // É o que permite rachar a conta pelo que cada um consumiu, em vez de
  // dividir por igual e alguém pagar a bebida do outro.
  tableGuestId    String?
  tableGuest      TableGuest?   @relation(fields: [tableGuestId], references: [id], onDelete: SetNull)
  order           CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuProduct     MenuProduct?  @relation(fields: [menuProductId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([tableGuestId])
}

model StoreCustomer {
  id               String          @id @default(cuid())
  name             String
  phone            String          @unique
  password         String
  address          String?
  birthDate        String?         // Data de aniversário (para mimos e cupons automáticos)
  cashbackBalance  Float           @default(0) // Saldo atual de cashback (R$)
  cashbackHistory  Json?           // Array: [{ orderId, amount, type: earn|redeem, date, storeId }]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  orders           CustomerOrder[]
  reviews          StoreReview[]
}

model StoreReview {
  id           String         @id @default(cuid())
  franchiseeId String
  customerId   String?
  orderId      String         @unique
  rating       Int
  comment      String?
  reply        String?
  replyAt      DateTime?
  createdAt    DateTime       @default(now())
  franchisee   User           @relation(fields: [franchiseeId], references: [id])
  customer     StoreCustomer? @relation(fields: [customerId], references: [id])
  order        CustomerOrder  @relation(fields: [orderId], references: [id])
}

// ========== MÓDULO DE GESTÃO FINANCEIRA AVANÇADA ==========

// Taxa cobrada por plataforma (iFood, 99Food, Jotajá, etc)
model PlatformFee {
  id         String   @id @default(cuid())
  platform   String   // "IFOOD" | "99FOOD" | "JOTAJA" | "OWN"
  label      String   // "iFood" | "99Food" | "Jotajá" | "Loja Própria"
  feePercent Float    @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Folha de pagamento: funcionários e freelancers
model PayrollEntry {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("EMPLOYEE") // "EMPLOYEE" | "FREELANCER"
  role        String?  // cargo / função
  amount      Float
  description String?
  payDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Abertura e fechamento de caixa
model CashRegister {
  id              String              @id @default(cuid())
  openedAt        DateTime            @default(now())
  closedAt        DateTime?
  openingAmount   Float               // dinheiro inicial informado
  status          String              @default("OPEN") // "OPEN" | "CLOSED"
  expectedTotal   Float?              // total calculado pelo sistema com base nos pedidos
  actualTotal     Float?              // total informado pelo operador
  discrepancy     Float?              // diferença (actualTotal - expectedTotal)
  justification   String?             // obrigatório se houver discrepância
  openedBy        String              // email do usuário
  closedBy        String?
  entries         CashRegisterEntry[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

// Entradas por forma de pagamento no fechamento
model CashRegisterEntry {
  id             String       @id @default(cuid())
  registerId     String
  method         String       // "CASH" | "CARD_CREDIT" | "CARD_DEBIT" | "PIX" | "VOUCHER" | "OTHER"
  methodLabel    String       // "Dinheiro" | "Cartão Crédito" | "Cartão Débito" | "PIX" | "Vale" | "Outro"
  expectedAmount Float        // sistema calculou
  actualAmount   Float        // operador informou
  register       CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

// ========== MÓDULO DE MOTOBOYS ==========

model Motoboy {
  id               String          @id @default(cuid())
  franchiseeId     String
  name             String
  phone            String?
  password         String?         // Senha de acesso ao App do Motoboy
  pinCode          String?         // PIN de acesso rápido
  active           Boolean         @default(true)
  lastLat          Float?          // Latitude em tempo real
  lastLng          Float?          // Longitude em tempo real
  lastLocationUpdate DateTime?     // Data/hora da última atualização de GPS
  // Tipo: "PER_DELIVERY" | "DAILY_RATE" | "BOTH" | "PER_KM"
  paymentType      String          @default("PER_DELIVERY")
  dailyRate        Float?          // Diária fixa (R$/dia)
  perDeliveryRate  Float?          // Valor fixo por entrega (R$)
  perKmRate        Float?          // Valor por KM percorrido (R$)
  notes            String?
  franchisee       User            @relation(fields: [franchiseeId], references: [id])
  orders           CustomerOrder[]
  routeSchedules   RouteSchedule[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([franchiseeId])
}

// ========== GARÇONS ==========
model Waiter {
  id               String          @id @default(cuid())
  franchiseeId     String
  name             String
  phone            String?
  active           Boolean         @default(true)
  commissionRate   Float?          @default(10) // Ex: 10% padrão de comissão
  notes            String?
  
  franchisee       User            @relation(fields: [franchiseeId], references: [id])
  tableSessions    TableSession[]
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([franchiseeId])
}

// ========== SESSÕES DE CAIXA ==========
model CashSession {
  id              String    @id @default(cuid())
  franchiseeId    String
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  status          String    @default("OPEN")    // OPEN | CLOSED
  openingAmount   Float     @default(0)          // Troco inicial
  // Valores informados no fechamento (manual/presencial)
  closingCash     Float?
  closingDebit    Float?
  closingCredit   Float?
  closingPix      Float?
  closingVoucher  Float?
  closingOthers   Json?                          // Outras formas customizadas
  // Valores calculados do sistema
  expectedCash    Float?
  expectedDebit   Float?
  expectedCredit  Float?
  expectedPix     Float?
  expectedVoucher Float?
  expectedTotal   Float?
  // Resultado
  difference      Float?                         // Positivo = sobra, Negativo = falta
  justification   String?                        // Justificativa da diferença
  closedBy        String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([franchiseeId])
}


// ========== FATURAMENTO: USE FIRST, PAY LATER ==========
// Ciclo mensal de cobrança por franqueado. 
// O franqueado usa o sistema o mês todo, e paga no fechamento.
// Pagamentos online recebidos vão abatendo a dívida em tempo real.

model FranchiseeBillingCycle {
  id               String    @id @default(cuid())
  franchiseeId     String
  // Referência do mês (ex: "2025-05" = Maio/2025)
  yearMonth        String    // formato "YYYY-MM"
  // Valores calculados
  totalSales       Float     @default(0)   // Total de vendas do mês
  planPercent      Float     @default(0)   // % aplicado (snapshot do plano no fechamento)
  amountDue        Float     @default(0)   // Valor devido = totalSales * planPercent / 100
  // Abatimentos acumulados de pagamentos online
  amountOffset     Float     @default(0)   // Já abatido por recebimentos online (Pagar.me)
  // Resultado no fechamento
  amountPending    Float     @default(0)   // amountDue - amountOffset (o que ainda falta)
  // Vencimento e taxas adicionais
  dueDate          DateTime?                 // Data limite de pagamento (closedAt + 10 dias)
  metaAdsFee       Float     @default(0)     // Taxa tráfego pago acumulada no mês (R$50/semana)
  totemFee         Float     @default(0)     // Taxa de totens ativos no mês (R$ 100 × N)
  // Status do ciclo
  status           String    @default("OPEN")
  // OPEN       = mês em andamento, abatendo em tempo real
  // CLOSED     = mês encerrado, link gerado se havia diferença
  // PAID       = quitado (link pago OU offset cobriu tudo)
  // FORGIVEN   = admin zerou manualmente
  closedAt         DateTime?
  // Link de cobrança da diferença (gerado no fechamento se amountPending > 0)
  asaasPaymentId   String?
  asaasBoletoUrl   String?
  asaasBoletoCode  String?
  asaasPixQrCode   String?   @db.Text
  // Log de abatimentos: [{ date, orderId, amount, pagarmeOrderId }]
  offsetLog        Json?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  franchisee       User      @relation(fields: [franchiseeId], references: [id])

  @@unique([franchiseeId, yearMonth])
}

// ========== META ADS MODULE ==========
// Campanhas de tráfego pago gerenciadas automaticamente pelo FireHub.
// Modelo: R$50/semana de gestão quando campanha ativa.

model MetaAdsCampaign {
  id               String    @id @default(cuid())
  franchiseeId     String
  franchisee       User      @relation(fields: [franchiseeId], references: [id])

  // IDs da Meta Marketing API
  metaCampaignId   String?   // Campanha no Meta
  metaAdSetId      String?   // Conjunto de anúncios
  metaAdId         String?   // Anúncio ativo
  metaAdCreativeId String?   // Criativo (imagem + copy)

  // Configuração da campanha
  status           String    @default("DRAFT")
  // DRAFT = configurando | ACTIVE = rodando | PAUSED = pausada | ENDED = encerrada
  weeklyBudget     Float     @default(100)   // Verba semanal em anúncio (R$)
  radiusKm         Int       @default(3)     // Raio de entrega em km
  objective        String    @default("LINK_CLICKS") // LINK_CLICKS | CONVERSIONS
  adCopy           String?   @db.Text        // Texto do anúncio gerado por IA
  adImageUrl       String?                   // Imagem usada no criativo

  // Métricas (atualizadas periodicamente via cron)
  spend            Float     @default(0)     // Gasto total acumulado
  impressions      Int       @default(0)
  clicks           Int       @default(0)
  ordersGenerated  Int       @default(0)     // Pedidos rastreados pelo Pixel
  revenue          Float     @default(0)     // Faturamento atribuído aos anúncios

  // Cobrança FireHub (R$50/semana de gestão)
  feeAccrued        Float    @default(0)     // Taxa de gestão acumulada — R$50 por semana ATIVA (não é % do gasto)
  feePaid           Float    @default(0)     // Total de taxa já cobrada
  lastBilledAt     DateTime?                 // Última cobrança semanal

  // Verba depositada via PIX
  depositTotal     Float     @default(0)     // Total depositado pelo franqueado
  depositUsed      Float     @default(0)     // Total enviado ao Meta

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ========== ESTOQUE E RECEITAS ==========

model StockItem {
  id            String             @id @default(cuid())
  franchiseeId  String
  name          String
  quantity      Float              @default(0)
  unit          String             @default("un") // "un", "g", "kg", "ml", "l"
  minQuantity   Float?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  unitCost      Float?             // Custo unitário do último recebimento (R$)
  supplier      String?            // Nome do último fornecedor
  transactions  StockTransaction[]
  recipeItems   ProductRecipe[]

  @@unique([franchiseeId, name])
}

model StockTransaction {
  id            String      @id @default(cuid())
  stockItemId   String
  quantity      Float       // Positiva (entrada), Negativa (saída)
  type          String      // "INPUT", "OUTPUT", "SALE", "WASTE"
  notes         String?
  createdAt     DateTime    @default(now())
  stockItem     StockItem   @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
}


model ProductRecipe {
  id               String       @id @default(cuid())
  menuProductId    String
  stockItemId      String
  quantityConsumed Float
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  menuProduct      MenuProduct  @relation(fields: [menuProductId], references: [id], onDelete: Cascade)
  stockItem        StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([menuProductId, stockItemId])
}

model StockInvoice {
  id            String             @id @default(cuid())
  franchiseeId  String
  invoiceNumber String?
  supplier      String?
  totalAmount   Float?
  imageUrl      String?
  processedData Json?              // JSON com itens detectados pela IA
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [franchiseeId], references: [id])

  @@index([franchiseeId])
}

model PrintJob {
  id           String   @id @default(cuid())
  franchiseeId String
  jobKey       String   @unique
  orderData    Json
  storeName    String?
  paperWidth   String?  @default("80mm")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@index([franchiseeId, status])
}

// === MÓDULO DE EMBAIXADORES / AFILIADOS ===
model Ambassador {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  phone             String?
  code              String     @unique // ex: "marcos" -> ?ref=marcos
  commissionPercent Float      @default(20) // % de comissão recorrente (ex: 20%)
  asaasWalletId     String?    // ID da conta/carteira no Asaas para Split
  pixKey            String?    // Referência opcional
  active            Boolean    @default(true)
  password          String?    // Hash da senha (opcional para quem logar no portal)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  referredStores    User[]     @relation("AmbassadorStores")
}

// === API ABERTA & WEBHOOKS DE SAÍDA (OPEN API V1) ===
model ApiKey {
  id           String    @id @default(cuid())
  franchiseeId String
  franchisee   User      @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  name         String
  keyPrefix    String
  keyHash      String    @unique
  permissions  Json?
  active       Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([franchiseeId])
}

model WebhookSubscription {
  id           String   @id @default(cuid())
  franchiseeId String
  franchisee   User     @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)
  url          String
  secret       String
  events       Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([franchiseeId])
}

// ══════════════════════════════════════════════════════════
// TRACKING DE CUSTOS POR LOJISTA
// ══════════════════════════════════════════════════════════
model UsageLog {
  id             String   @id @default(cuid())
  franchiseeId   String
  category       String   // WHATSAPP_MSG | WHATSAPP_CONV | GEMINI_CHAT | GEMINI_VISION | STORAGE
  subCategory    String?  // SERVICE | MARKETING | UTILITY | INPUT_TOKENS | OUTPUT_TOKENS
  quantity       Float    @default(1)
  estimatedCost  Float    @default(0)
  metadata       Json?
  yearMonth      String   // "2026-08"
  createdAt      DateTime @default(now())
  franchisee     User     @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)

  @@index([franchiseeId, yearMonth])
  @@index([category, yearMonth])
}
