{
  "manifest_version": 3,
  "name": "FireHub Prazos",
  "version": "0.1.0",
  "description": "Ajusta o prazo de entrega no Portal do Parceiro sozinho, pela carga da cozinha do seu painel e pelos motoboys na casa.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://portal.ifood.com.br/*",
    "https://*.ifood.com.br/*",
    "https://firehubfood.com.br/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.ifood.com.br/*",
        "https://*.ifood.com.br/*"
      ],
      "js": [
        "scripts/ifood.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
