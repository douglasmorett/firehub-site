{
  "name": "firehub-print-assistant",
  "version": "1.2.20",
  "description": "Assistente FireHub de Impressão — servidor local para impressoras térmicas",
  "main": "main.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.firehub.print-assistant",
    "productName": "FireHub Assistente de Impressao",
    "files": [
      "main.js",
      "server.js",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FireHub Assistente de Impressao",
      "artifactName": "FireHub-Assistente-Impressao-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "FireHub-Assistente-Impressao.exe"
    }
  }
}